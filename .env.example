# Neon Postgres. The pooled URL is used by the app; the unpooled one (optional) by migrations.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED=""

# better-auth: a random secret (openssl rand -base64 32) and the public URL of the app.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"

# Encrypts the Vercel/Railway/GitHub tokens stored in the database: 32 random bytes, base64
# (openssl rand -base64 32). Keep it out of the database and its backups. Losing it means
# everyone has to reconnect their accounts.
TOKEN_ENCRYPTION_KEY=""

# Set to 1 to stop new sign-ups, e.g. once your own account exists on a private deployment.
DISABLE_SIGNUP=""
