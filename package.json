{
  "name": "overwatcher",
  "productName": "Overwatcher",
  "version": "0.1.0",
  "description": "Your latest Vercel and Railway deployments, with their commits and PRs, in one place.",
  "private": true,
  "type": "module",
  "main": "out/electron/main.js",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "node scripts/brand-dev-electron.mjs && tsc -p electron && OVERWATCHER_DEV=1 electron .",
    "demo": "node scripts/brand-dev-electron.mjs && tsc -p electron && OVERWATCHER_DEV=1 OVERWATCHER_DEMO=1 electron .",
    "build": "vite build && tsc -p electron",
    "start": "electron .",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p electron --noEmit",
    "dist": "bun run build && electron-builder --mac",
    "postinstall": "node scripts/brand-dev-electron.mjs"
  },
  "trustedDependencies": [
    "electron"
  ],
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.78.0",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "bits-ui": "^2.20.0",
    "cn": "^0.5.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.8.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "dev.overwatcher.app",
    "productName": "Overwatcher",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/Overwatcher.icon",
      "darkModeSupport": true
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
