{
  "name": "overwatcher",
  "version": "0.1.0",
  "description": "Your latest Vercel and Railway deployments, with their commits and PRs, in one place.",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "demo": "OVERWATCHER_DEMO=1 vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.78.0",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "bits-ui": "^2.20.0",
    "cn": "^0.5.0",
    "drizzle-kit": "^0.31.11",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.8.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.8"
  }
}
