{
  "name": "overwatcher",
  "productName": "Overwatcher",
  "version": "0.1.0",
  "description": "Your latest Vercel and Railway deployments, with their commits and PRs, in one place.",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
